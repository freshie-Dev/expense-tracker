# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# --- Compiled output (Angular, under frontend/) ---
/frontend/dist
/dist
/tmp
/out-tsc
/bazel-out

# --- Node ---
/node_modules
/frontend/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# --- Backend (Express / TypeScript) ---
backend/node_modules
backend/dist
backend/.env
backend/.env.local
backend/.env.*.local
backend/coverage
backend/*.log

# --- Environment & secrets (root) ---
.env
.env.local
.env.*.local
!.env.example

# --- IDEs and editors ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# --- Angular ---
/.angular/cache
/frontend/.angular/cache
.sass-cache/

# --- Testing & coverage ---
/coverage
/frontend/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# --- Misc ---
/connect.lock
*.tsbuildinfo

# --- System files ---
.DS_Store
Thumbs.db
Desktop.ini
